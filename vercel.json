{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "cookie", "key": "portfolio-locale", "value": "es" }],
      "destination": "/es/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "cookie", "key": "portfolio-locale", "value": "en" }],
      "destination": "/en/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept-language", "value": "es(?:-[A-Za-z0-9]+)*(?:[;,].*)?" }],
      "destination": "/es/",
      "permanent": false
    },
    { "source": "/", "destination": "/en/", "permanent": false }
  ]
}
